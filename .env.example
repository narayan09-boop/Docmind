# DocMind Environment Configuration Template
# Copy this file to .env and configure for your environment

# Environment Mode: development | staging | production | testing
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
# API_KEY=your-secure-random-master-api-key
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_QUERY_LENGTH=1000
RATE_LIMIT_PER_MINUTE=60

# Vector Embeddings & Reranking
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
RRF_K=60

# LLM Provider: openai | ollama | local
LLM_PROVIDER=local
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0

# Ingestion & Chunking
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
SEMANTIC_SIMILARITY_PERCENTILE=85.0

# Semantic Cache
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
# REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_TTL_SECONDS=86400
